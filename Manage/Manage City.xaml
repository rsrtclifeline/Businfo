<Window
    x:Class="Businfo.Manage.Manage_City"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Cities"
    Width="950"
    Height="580"
    Background="#F8FAFC"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Header & Filter Bar  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,0,0,20"
            LastChildFill="False">
            <!--  Left Heading  -->
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Vertical">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    Text="Manage Cities" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    Text="Manage route coverage, states, and districts" />
            </StackPanel>

            <!--  Right Search & Filters  -->
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <!--  Search Box  -->
                <TextBox
                    x:Name="SearchTextBox"
                    Width="200"
                    Height="36"
                    Style="{StaticResource ModernSearchBox}"
                    Text="Search city, state..." />

                <!--  Vendor Filter ComboBox  -->
                <ComboBox
                    Width="160"
                    Height="36"
                    Margin="10,0,0,0"
                    IsEditable="False"
                    SelectedIndex="0">
                    <ComboBoxItem Content="All Vendors" />
                    <ComboBoxItem Content="Vendor 1" />
                    <ComboBoxItem Content="Vendor 2" />
                </ComboBox>
            </StackPanel>
        </DockPanel>

        <!--  Main DataGrid Container Card  -->
        <Border
            Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Direction="270"
                    Opacity="0.04"
                    ShadowDepth="2"
                    Color="#0F172A" />
            </Border.Effect>

            <DataGrid
                x:Name="BusDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                RowHeaderWidth="0"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                SnapsToDevicePixels="True"
                Style="{StaticResource ModernDataGridStyle}">

                <DataGrid.Columns>
                    <!--  City Name Column  -->
                    <DataGridTextColumn
                        Width="1.2*"
                        Binding="{Binding CityName}"
                        Header="City Name" />

                    <!--  State Column  -->
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding State}"
                        Header="State" />

                    <!--  District Column  -->
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding District}"
                        Header="District" />

                    <!--  Action Column  -->
                    <DataGridTemplateColumn Width="110" Header="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <!--  Edit Button  -->
                                    <Button
                                        Background="#E0E7FF"
                                        Click="Button_Click"
                                        Style="{StaticResource ModernGridActionButton}"
                                        ToolTip="Edit City">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#3730A3"
                                            Text="&#xE70F;" />
                                    </Button>

                                    <!--  Delete Button  -->
                                    <Button
                                        Background="#FEE2E2"
                                        Click="Button_Click_1"
                                        Style="{StaticResource ModernGridActionButton}"
                                        ToolTip="Delete City">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#991B1B"
                                            Text="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>