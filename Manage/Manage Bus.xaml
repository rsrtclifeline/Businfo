<Window
    x:Class="Businfo.Manage.Manage_Bus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Manage Buses | RSRTC Admin Panel"
    Width="1100"
    Height="650"
    Background="#F8FAFC"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Top Header & Filter Bar  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,0,0,20"
            LastChildFill="False">
            <!--  Left Header  -->
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Vertical">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    Text="Manage Buses" />
                <TextBlock
                    x:Name="txtRecordCount"
                    Margin="0,4,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    Text="Total 0 routes active" />
            </StackPanel>

            <!--  Right Controls  -->
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <!--  Search Box  -->
                <TextBox
                    x:Name="SearchTextBox"
                    Width="240"
                    Height="36"
                    GotFocus="SearchTextBox_GotFocus"
                    LostFocus="SearchTextBox_LostFocus"
                    Style="{StaticResource ModernSearchBox}"
                    Text="Search route, city, bus..."
                    TextChanged="SearchTextBox_TextChanged" />

                <!--  Vendor Filter ComboBox  -->
                <ComboBox
                    x:Name="cmbVendorFilter"
                    Width="170"
                    Height="36"
                    Margin="10,0,0,0"
                    IsEditable="False"
                    SelectionChanged="cmbVendorFilter_SelectionChanged" />

                <!--  Add New Bus Button  -->
                <Button
                    Margin="12,0,0,0"
                    Click="btnAddBus_Click"
                    Content="+ Add New Bus"
                    Style="{StaticResource ModernPrimaryButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <!--  Main DataGrid Container Card  -->
        <Border
            Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="16"
                    Direction="270"
                    Opacity="0.04"
                    ShadowDepth="2"
                    Color="#0F172A" />
            </Border.Effect>

            <DataGrid
                x:Name="BusDataGrid"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                Style="{StaticResource ModernDataGridStyle}">

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Line}"
                        Header="Line / No" />

                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding Vendor}"
                        Header="Vendor" />

                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding From}"
                        Header="From" />

                    <DataGridTextColumn
                        Width="130"
                        Binding="{Binding To}"
                        Header="To" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Route}"
                        Header="Route Details" />

                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding Departure}"
                        Header="Departure" />

                    <DataGridTextColumn
                        Width="105"
                        Binding="{Binding Arrival}"
                        Header="Arrival" />

                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding Depot}"
                        Header="Bus Depot" />

                    <!--  Action Column  -->
                    <DataGridTemplateColumn Width="135" Header="Actions">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">

                                    <!--  Edit  -->
                                    <Button
                                        Background="#E0E7FF"
                                        Click="Button_Click"
                                        Style="{StaticResource ModernGridActionButton}"
                                        ToolTip="Edit Route">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#3730A3"
                                            Text="&#xE70F;" />
                                    </Button>

                                    <!--  Clone  -->
                                    <Button
                                        Background="#DCFCE7"
                                        Click="Button_Click_1"
                                        Style="{StaticResource ModernGridActionButton}"
                                        ToolTip="Clone as New Bus">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#166534"
                                            Text="&#xE8EE;" />
                                    </Button>

                                    <!--  Delete  -->
                                    <Button
                                        Background="#FEE2E2"
                                        Click="Button_Click_2"
                                        Style="{StaticResource ModernGridActionButton}"
                                        ToolTip="Delete Route">
                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#991B1B"
                                            Text="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>