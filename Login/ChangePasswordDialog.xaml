<Window
    x:Class="Businfo.Login.ChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Change Password"
    Width="380"
    Height="360"
    AllowsTransparency="True"
    Background="#181928"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Padding="20"
        Background="#181928"
        BorderBrush="#2D2E49"
        BorderThickness="1"
        CornerRadius="12">
        <StackPanel VerticalAlignment="Center">
            <TextBlock
                Margin="0,0,0,15"
                FontSize="18"
                FontWeight="Bold"
                Foreground="White"
                Text="Change Password" />

            <TextBlock
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="#A0A5BD"
                Text="Current Password" />
            <PasswordBox
                x:Name="txtOldPass"
                Height="38"
                Margin="0,0,0,12"
                Padding="8,0"
                Background="#24253B"
                BorderThickness="0"
                Foreground="White" />

            <TextBlock
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="#A0A5BD"
                Text="New Password" />
            <PasswordBox
                x:Name="txtNewPass"
                Height="38"
                Margin="0,0,0,12"
                Padding="8,0"
                Background="#24253B"
                BorderThickness="0"
                Foreground="White" />

            <TextBlock
                Margin="0,0,0,5"
                FontSize="12"
                Foreground="#A0A5BD"
                Text="Confirm New Password" />
            <PasswordBox
                x:Name="txtConfirmPass"
                Height="38"
                Margin="0,0,0,20"
                Padding="8,0"
                Background="#24253B"
                BorderThickness="0"
                Foreground="White" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Width="80"
                    Height="34"
                    Margin="0,0,10,0"
                    Background="#374151"
                    BorderThickness="0"
                    Click="BtnCancel_Click"
                    Content="Cancel"
                    Cursor="Hand"
                    Foreground="White" />
                <Button
                    Width="90"
                    Height="34"
                    Background="#2563EB"
                    BorderThickness="0"
                    Click="BtnUpdate_Click"
                    Content="Update"
                    Cursor="Hand"
                    Foreground="White" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>