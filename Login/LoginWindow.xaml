<Window
    x:Class="Businfo.Login.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Businfo Login"
    Width="500"
    Height="560"
    AllowsTransparency="True"
    Background="Transparent"
    Cursor="Arrow"
    ResizeMode="NoResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--  Modal Close Button  -->
        <Style x:Key="LoginCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Foreground="#64748B"
                                Text="&#xE711;" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Input Box Container Style  -->
        <Style x:Key="LoginInputContainer" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!--  Primary Action Button  -->
        <Style x:Key="LoginPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="btnBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!--  Floating Dialog Card with Soft Shadow  -->
        <Border
            x:Name="GlowPanel"
            Width="420"
            Height="480"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Direction="270"
                    Opacity="0.08"
                    ShadowDepth="6"
                    Color="#0F172A" />
            </Border.Effect>

            <Grid Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Top Header Row  -->
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#0F172A"
                            Text="Businfo Admin Portal" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="13"
                            Foreground="#64748B"
                            Text="Sign in to access fleet control center" />
                    </StackPanel>

                    <!--  Close Window Button  -->
                    <Button
                        Click="CloseButton_Click"
                        DockPanel.Dock="Right"
                        Style="{StaticResource LoginCloseButton}"
                        ToolTip="Close" />
                </DockPanel>

                <!--  Inputs & Submit Stack  -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">

                    <!--  Username Field  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="Operator Username / ID" />
                    <Border Margin="0,0,0,16" Style="{StaticResource LoginInputContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#94A3B8"
                                Text="&#xE77B;" />
                            <TextBox
                                x:Name="UsernameBox"
                                Grid.Column="1"
                                Padding="4,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#0F172A" />
                        </Grid>
                    </Border>

                    <!--  Password Field  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#475569"
                        Text="Account Password" />
                    <Border Margin="0,0,0,16" Style="{StaticResource LoginInputContainer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Foreground="#94A3B8"
                                Text="&#xE72E;" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Grid.Column="1"
                                Padding="4,0"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="#0F172A" />
                        </Grid>
                    </Border>

                    <!--  Options: Remember Me + Forgot Password  -->
                    <Grid Margin="0,0,0,24">
                        <CheckBox
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="Remember my session"
                            FontSize="12"
                            Foreground="#64748B" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#2563EB"
                            Text="Forgot Password?" />
                    </Grid>

                    <!--  Submit Button  -->
                    <Button Content="Sign In to Console" Style="{StaticResource LoginPrimaryButton}" />

                    <!--  Developer & Brand Notice  -->
                    <TextBlock
                        Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#94A3B8"
                        Text="Powered by YHGIndian Security Engine" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>