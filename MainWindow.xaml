<Window
    x:Class="Businfo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Businfo"
    xmlns:manage="clr-namespace:Businfo.Manage"
    Title="YHG UI Handler"
    Width="950"
    Height="600"
    Background="#F8FAFC"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Window.Resources>
        <!--  Modern Light Menu Item Style  -->
        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Modern Light TabItem Style  -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            CornerRadius="6,6,0,0"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                x:Name="ContentSite"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#2563EB" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!--  Top Navigation Bar  -->
        <Border
            Height="48"
            Padding="16,0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Left Menus  -->
                <Menu VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="File" Style="{StaticResource ModernMenuItem}" />
                    <MenuItem Header="Edit" Style="{StaticResource ModernMenuItem}" />
                    <MenuItem Header="View" Style="{StaticResource ModernMenuItem}" />
                    <MenuItem Header="Help" Style="{StaticResource ModernMenuItem}" />
                </Menu>

                <!--  Right Auth Menu Item  -->
                <Menu
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Background="Transparent">
                    <MenuItem
                        Click="MenuItem_Click"
                        Header="Login"
                        Style="{StaticResource ModernMenuItem}" />
                </Menu>
            </Grid>
        </Border>

        <!--  GLOBAL PINNED FOOTER (OUTSIDE TABCONTROL)  -->
        <Border
            Height="38"
            Padding="20,0"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <DockPanel LastChildFill="False">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="12"
                        Foreground="#64748B"
                        Text="Developed &amp; Maintained by " />
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#2563EB"
                        Text="Naveen Ojha (YHGIndian)" />
                </StackPanel>

                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    FontSize="12"
                    Foreground="#94A3B8"
                    Text="Businfo Operations Suite © 2026 • All Rights Reserved" />
            </DockPanel>
        </Border>

        <!--  Main Tab Control  -->
        <TabControl
            Margin="16,12,16,8"
            Background="Transparent"
            BorderThickness="0">
            <TabControl.Resources>
                <Style BasedOn="{StaticResource ModernTabItem}" TargetType="TabItem" />
            </TabControl.Resources>

            <!--  Home Tab  -->
            <TabItem Header="Home">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Top Dashboard Welcome Banner  -->
                        <Border
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            Padding="24,20"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="14"
                                    Direction="270"
                                    Opacity="0.04"
                                    ShadowDepth="2"
                                    Color="#0F172A" />
                            </Border.Effect>
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock
                                        FontSize="22"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="RSRTC Operations Hub" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="13"
                                        Foreground="#64748B"
                                        Text="Centralized transit administration, fleet scheduling, and depot management portal." />
                                </StackPanel>
                                <Border
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Background="#EFF6FF"
                                    CornerRadius="8"
                                    DockPanel.Dock="Right">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#2563EB"
                                        Text="System Online • v1.0" />
                                </Border>
                            </DockPanel>
                        </Border>

                        <!--  SECTION 1: Master Records & Management  -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,20">
                            <TextBlock
                                Margin="2,0,0,12"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#64748B"
                                Text="MASTER RECORD MANAGEMENT" />

                            <UniformGrid HorizontalAlignment="Stretch" Columns="3">
                                <!--  Manage Buses  -->
                                <Button
                                    Height="78"
                                    Margin="0,0,12,12"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Left"
                                                        Background="#EFF6FF"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Foreground="#2563EB"
                                                            Text="&#xE806;" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="Manage Buses" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Active routes, stops &amp; timelogs" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Manage Cities  -->
                                <Button
                                    Height="78"
                                    Margin="0,0,12,12"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_1"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Left"
                                                        Background="#F5F3FF"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Foreground="#7C3AED"
                                                            Text="&#xE707;" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="Manage Cities" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Coverage, districts &amp; codes" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#C4B5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Manage Vendors  -->
                                <Button
                                    Height="78"
                                    Margin="0,0,0,12"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_3"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Left"
                                                        Background="#ECFDF5"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Foreground="#059669"
                                                            Text="&#xE716;" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="Manage Vendors" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Operators, profiles &amp; contacts" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#A7F3D0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Manage Depots  -->
                                <Button
                                    Height="78"
                                    Margin="0,0,12,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_8"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Left"
                                                        Background="#FFFBEB"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Foreground="#D97706"
                                                            Text="&#xE80F;" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="Manage Depots" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Base stations &amp; depot zones" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FDE68A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Manage Bus Types  -->
                                <Button
                                    Height="78"
                                    Margin="0,0,12,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_7"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,12"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="36"
                                                        Height="36"
                                                        HorizontalAlignment="Left"
                                                        Background="#FEF2F2"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="16"
                                                            Foreground="#DC2626"
                                                            Text="&#xE7C3;" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="Manage Bus Types" />
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Seater, sleeper, AC standards" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FECACA" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </UniformGrid>
                        </StackPanel>

                        <!--  SECTION 2: Quick Creation Actions  -->
                        <StackPanel Grid.Row="2">
                            <TextBlock
                                Margin="2,0,0,12"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="#64748B"
                                Text="QUICK CREATION &amp; ENTRY" />

                            <UniformGrid HorizontalAlignment="Stretch" Columns="3">
                                <!--  Add Bus  -->
                                <Button
                                    Height="68"
                                    Margin="0,0,12,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_5"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Border
                                                        Width="32"
                                                        Height="32"
                                                        Background="#2563EB"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="14"
                                                            Foreground="#FFFFFF"
                                                            Text="&#xE710;" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="+ Add New Bus" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Configure new schedule route" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Add City  -->
                                <Button
                                    Height="68"
                                    Margin="0,0,12,0"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_4"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Border
                                                        Width="32"
                                                        Height="32"
                                                        Background="#059669"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="14"
                                                            Foreground="#FFFFFF"
                                                            Text="&#xE710;" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="+ Add New City" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Register regional transit points" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#ECFDF5" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#A7F3D0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!--  Add Vendor  -->
                                <Button
                                    Height="68"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    Click="Button_Click_2"
                                    Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                x:Name="bd"
                                                Padding="16,10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                                    <Border
                                                        Width="32"
                                                        Height="32"
                                                        Background="#7C3AED"
                                                        CornerRadius="6">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            FontSize="14"
                                                            Foreground="#FFFFFF"
                                                            Text="&#xE710;" />
                                                    </Border>
                                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="#0F172A"
                                                            Text="+ Add New Vendor" />
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="#64748B"
                                                            Text="Onboard partner travel agency" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F5F3FF" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#C4B5FD" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!--  Stats Tab (Revamped Modern KPI & Analytics Dashboard)  -->
            <TabItem Header="Stats">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,12,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Header  -->
                        <DockPanel
                            Grid.Row="0"
                            Margin="0,0,0,20"
                            LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#0F172A"
                                    Text="Transit Network Telemetry &amp; KPIs" />
