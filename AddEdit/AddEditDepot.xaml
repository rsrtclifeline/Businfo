<Window
    x:Class="Businfo.AddEdit.AddEditDepot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Businfo.AddEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add / Edit Depot"
    Width="560"
    Background="#F8FAFC"
    ResizeMode="NoResize"
    SizeToContent="Height"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Form Field Label  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  Secondary Neutral Button  -->
        <Style x:Key="ModalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary Blue Button  -->
        <Style x:Key="ModalPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock
                FontSize="18"
                FontWeight="Bold"
                Foreground="#0F172A"
                Text="Depot Details" />
            <TextBlock
                Margin="0,3,0,0"
                FontSize="12"
                Foreground="#64748B"
                Text="Configure bus operations center, regional branch, and depot code." />
        </StackPanel>

        <!--  Form Card (2x2 Grid)  -->
        <Border
            Grid.Row="1"
            Padding="20,16"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.04"
                    ShadowDepth="2"
                    Color="#0F172A" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  State  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="State" />
                    <TextBox
                        x:Name="txtState"
                        Height="36"
                        Style="{StaticResource ModernSearchBox}" />
                </StackPanel>

                <!--  City  -->
                <StackPanel
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="City" />
                    <TextBox
                        x:Name="txtCity"
                        Height="36"
                        Style="{StaticResource ModernSearchBox}" />
                </StackPanel>

                <!--  Depot Name  -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Depot Name" />
                    <TextBox
                        x:Name="txtDepot"
                        Height="36"
                        Style="{StaticResource ModernSearchBox}" />
                </StackPanel>

                <!--  Depot Number  -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Depot Number" />
                    <TextBox
                        x:Name="txtDepotNumber"
                        Height="36"
                        Style="{StaticResource ModernSearchBox}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Action Buttons Footer  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnDiscard"
                Margin="0,0,10,0"
                Click="btnDiscard_Click"
                Content="Cancel"
                Style="{StaticResource ModalSecondaryButtonStyle}" />

            <Button
                x:Name="btnSave"
                Click="btnSave_Click"
                Content="Save Depot"
                Style="{StaticResource ModalPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>