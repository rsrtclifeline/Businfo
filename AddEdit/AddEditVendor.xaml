<Window
    x:Class="Businfo.AddEdit.AddEditVendor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Businfo.AddEdit"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Add / Edit Vendor"
    Width="880"
    Height="680"
    Background="#F8FAFC"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  Form Field Label  -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  Modern Multiline TextBox  -->
        <Style x:Key="ModernMultiLineTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="txtBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter TargetName="txtBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Secondary Neutral Action Button  -->
        <Style x:Key="ModalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CBD5E1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Primary Action Button (Save)  -->
        <Style x:Key="ModalPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top Header  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,0,0,18"
            LastChildFill="False">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Vertical">
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#0F172A"
                    Text="Add / Edit Vendor" />
                <TextBlock
                    Margin="0,3,0,0"
                    FontSize="13"
                    Foreground="#64748B"
                    Text="Manage transport operator profile, contact records, and fleet details" />
            </StackPanel>
        </DockPanel>

        <!--  Scrollable Form Container Card  -->
        <Border
            Grid.Row="1"
            Background="#FFFFFF"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.04"
                    ShadowDepth="2"
                    Color="#0F172A" />
            </Border.Effect>

            <ScrollViewer Padding="24,20" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Vendor Name  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Vendor / Travel Agency Name" />
                        <TextBox
                            x:Name="txtVendorName"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Total Vehicles  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Number of Vehicles" />
                        <TextBox
                            x:Name="txtNoOfVehicle"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Contact 1  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Primary Contact No." />
                        <TextBox
                            x:Name="txtContact1"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Contact 2  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Secondary Contact No." />
                        <TextBox
                            x:Name="txtContact2"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Email  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Official Email" />
                        <TextBox
                            x:Name="txtEmail"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Website  -->
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Website URL" />
                        <TextBox
                            x:Name="txtWebsite"
                            Height="36"
                            Style="{StaticResource ModernSearchBox}" />
                    </StackPanel>

                    <!--  Full Width: Address  -->
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Registered Office Address" />
                        <TextBox
                            x:Name="txtAddress"
                            Height="80"
                            Style="{StaticResource ModernMultiLineTextBox}" />
                    </StackPanel>

                    <!--  Full Width: About  -->
                    <StackPanel
                        Grid.Row="3"
                        Grid.Column="2"
                        Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="About / Operational Summary" />
                        <TextBox
                            x:Name="txtAbout"
                            Height="80"
                            Style="{StaticResource ModernMultiLineTextBox}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!--  Bottom Action Buttons Footer  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,10,0"
                Click="Button_Click_1"
                Content="Discard"
                Style="{StaticResource ModalSecondaryButtonStyle}" />

            <Button
                Click="Button_Click"
                Content="Save Vendor"
                Style="{StaticResource ModalPrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>